DATABASE_URL=postgres://user:password@localhost:5432/sohba
PORT=3000
# true = show draft / in-review lessons (dev & review only). Keep false in production.
PREVIEW_DRAFTS=false
# true when the DB host requires SSL (Neon, Render, Railway, ...)
PGSSL=false
RATE_LIMIT_PER_MIN=120
# Signs admin session cookies. 32+ random chars, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Leave empty to disable /admin.
SESSION_SECRET=
