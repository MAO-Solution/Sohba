{
  "name": "sohba",
  "version": "0.1.0",
  "private": true,
  "description": "صحبة — صاحبك في طريقك لربنا",
  "type": "module",
  "engines": { "node": "22.x" },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "migrate": "node --env-file-if-exists=.env db/migrate.js",
    "seed": "node --env-file-if-exists=.env db/seed.js",
    "build:preview": "node scripts/build-preview.js",
    "vercel-build": "node db/migrate.js && node db/seed.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.1"
  }
}
